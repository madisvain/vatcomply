---
source: tests/openapi.rs
expression: value
---
{
  "components": {},
  "info": {
    "description": "API for automated VAT compliance and currency conversion.",
    "title": "Vatcomply API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "root",
        "responses": {
          "200": {
            "description": "Service description"
          }
        }
      }
    },
    "/countries": {
      "get": {
        "operationId": "countries",
        "parameters": [
          {
            "description": "Search by country name, ISO2, or ISO3.",
            "in": "path",
            "name": "search",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Filter by region.",
            "in": "path",
            "name": "region",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Filter by subregion.",
            "in": "path",
            "name": "subregion",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Filter by currency code.",
            "in": "path",
            "name": "currency",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Countries"
          }
        }
      }
    },
    "/currencies": {
      "get": {
        "operationId": "currencies",
        "parameters": [
          {
            "description": "Search by code or name.",
            "in": "path",
            "name": "search",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Currencies"
          }
        }
      }
    },
    "/geolocate": {
      "get": {
        "operationId": "geolocate",
        "responses": {
          "200": {
            "description": "Country for the CDN header"
          },
          "404": {
            "description": "Country missing or unknown"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Process is up"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Process is up"
          }
        }
      }
    },
    "/iban": {
      "get": {
        "operationId": "iban",
        "parameters": [
          {
            "description": "IBAN to validate.",
            "in": "path",
            "name": "iban",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Valid IBAN"
          },
          "400": {
            "description": "Invalid IBAN"
          },
          "422": {
            "description": "Missing iban"
          }
        }
      }
    },
    "/rates": {
      "get": {
        "operationId": "rates",
        "parameters": [
          {
            "description": "Base currency. Defaults to EUR.",
            "in": "path",
            "name": "base",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Comma-separated currency codes.",
            "in": "path",
            "name": "symbols",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Historical date, YYYY-MM-DD. Empty means today.",
            "in": "path",
            "name": "date",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exchange rates"
          },
          "400": {
            "description": "Invalid currency or date"
          },
          "404": {
            "description": "No rate for that date"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Legacy readiness shim"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Rates loaded"
          }
        }
      }
    },
    "/vat": {
      "get": {
        "operationId": "vat",
        "parameters": [
          {
            "description": "VAT number, country prefix plus 8-12 letters or digits.",
            "in": "path",
            "name": "vat_number",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "VIES result"
          },
          "400": {
            "description": "Invalid number or permanent VIES fault"
          },
          "422": {
            "description": "Missing vat_number"
          },
          "503": {
            "description": "VIES unavailable"
          }
        }
      }
    },
    "/vat_rates": {
      "get": {
        "operationId": "vat_rates",
        "parameters": [
          {
            "description": "EU member state code. Greece is EL.",
            "in": "path",
            "name": "country_code",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "EU VAT rates"
          }
        }
      }
    }
  }
}
